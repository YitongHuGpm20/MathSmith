[node name="SearchRow" type="HBoxContainer" parent="MainMargin/MainLayout"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="SearchInput" type="LineEdit" parent="MainMargin/MainLayout/SearchRow"]
custom_minimum_size = Vector2(0, 48)
