[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/UI/LobbyUI.gd" id="1_lobby_ui"]

[node name="LobbyScene" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_lobby_ui")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.09, 0.105, 0.14, 1)
mouse_filter = 2

[node name="MainMargin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 48.0
offset_top = 36.0
offset_right = -48.0
offset_bottom = -36.0
grow_horizontal = 2
grow_vertical = 2

[node name="MainLayout" type="VBoxContainer" parent="MainMargin"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Header" type="HBoxContainer" parent="MainMargin/MainLayout"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TitleGroup" type="VBoxContainer" parent="MainMargin/MainLayout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="TitleLabel" type="Label" parent="MainMargin/MainLayout/Header/TitleGroup"]
layout_mode = 2
theme_override_font_sizes/font_size = 32
text = "MathSmith Lobby"

[node name="SubtitleLabel" type="Label" parent="MainMargin/MainLayout/Header/TitleGroup"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.74, 0.82, 1)
theme_override_font_sizes/font_size = 16
text = "Choose what to practice and how to solve it."

[node name="CurrentLevelTypeLabel" type="Label" parent="MainMargin/MainLayout/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.45, 0.82, 1, 1)
theme_override_font_sizes/font_size = 18
text = "Current Mode: Step Ordering"
vertical_alignment = 1

[node name="HomeButton" type="Button" parent="MainMargin/MainLayout/Header"]
custom_minimum_size = Vector2(96, 40)
layout_mode = 2
mouse_default_cursor_shape = 2
text = "Home"

[node name="LevelTypeRow" type="HBoxContainer" parent="MainMargin/MainLayout"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="StepOrderingButton" type="Button" parent="MainMargin/MainLayout/LevelTypeRow"]
custom_minimum_size = Vector2(180, 44)
layout_mode = 2
text = "Step Ordering"

[node name="ChoiceOrderingButton" type="Button" parent="MainMargin/MainLayout/LevelTypeRow"]
custom_minimum_size = Vector2(180, 44)
layout_mode = 2
disabled = true
text = "Multiple-Choice Ordering - M3"

[node name="FillProcessButton" type="Button" parent="MainMargin/MainLayout/LevelTypeRow"]
custom_minimum_size = Vector2(180, 44)
layout_mode = 2
disabled = true
text = "Fill in the Process - M3"

[node name="SectionHeader" type="HBoxContainer" parent="MainMargin/MainLayout"]
layout_mode = 2

[node name="LevelSectionTitle" type="Label" parent="MainMargin/MainLayout/SectionHeader"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 22
text = "Choose a Level"

[node name="LevelCountLabel" type="Label" parent="MainMargin/MainLayout/SectionHeader"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.74, 0.82, 1)
text = "12 Levels"

[node name="LevelScroll" type="ScrollContainer" parent="MainMargin/MainLayout"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="LevelCardContainer" type="GridContainer" parent="MainMargin/MainLayout/LevelScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16
columns = 3
