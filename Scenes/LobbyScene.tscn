[ext_resource type="Texture2D" path="res://Assets/Icons/fill.svg" id="10_fill"]
[ext_resource type="Texture2D" path="res://Assets/Icons/other.svg" id="11_other"]

[node name="LobbyScene" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_lobby_ui")

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.018, 0.027, 0.055, 1)
mouse_filter = 2

[node name="MainMargin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 48.0
offset_top = 36.0
offset_right = -48.0
offset_bottom = -36.0
grow_horizontal = 2
grow_vertical = 2

[node name="MainLayout" type="VBoxContainer" parent="MainMargin"]
layout_mode = 2
theme_override_constants/separation = 20

[node name="Header" type="HBoxContainer" parent="MainMargin/MainLayout"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="TitleGroup" type="VBoxContainer" parent="MainMargin/MainLayout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 4

[node name="TitleLabel" type="Label" parent="MainMargin/MainLayout/Header/TitleGroup"]
layout_mode = 2
theme_override_font_sizes/font_size = 34
text = "MathSmith Lobby"

[node name="SubtitleLabel" type="Label" parent="MainMargin/MainLayout/Header/TitleGroup"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 0.74, 0.82, 1)
theme_override_font_sizes/font_size = 16
text = "Choose what to practice and how to solve it."

[node name="HomeButton" type="Button" parent="MainMargin/MainLayout/Header"]
custom_minimum_size = Vector2(152, 48)
layout_mode = 2
size_flags_vertical = 4
mouse_default_cursor_shape = 2
theme_override_font_sizes/font_size = 17
theme_override_constants/h_separation = 7
text = "Home"
icon = ExtResource("3_home")
icon_max_width = 18

[node name="SettingsButton" type="Button" parent="MainMargin/MainLayout/Header"]
custom_minimum_size = Vector2(152, 48)
layout_mode = 2
size_flags_vertical = 4
theme_override_font_sizes/font_size = 17
theme_override_constants/h_separation = 7
text = "Settings"
icon = ExtResource("4_settings")
icon_max_width = 18

[node name="LevelTypeRow" type="HBoxContainer" parent="MainMargin/MainLayout"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="StepOrderingButton" type="Button" parent="MainMargin/MainLayout/LevelTypeRow"]
custom_minimum_size = Vector2(180, 44)
layout_mode = 2
toggle_mode = true
button_pressed = true
text = "Step Ordering"
icon = ExtResource("5_steps")
icon_max_width = 18

[node name="MasteryPanel" type="PanelContainer" parent="MainMargin/MainLayout"]
layout_mode = 2

[node name="MasteryMargin" type="MarginContainer" parent="MainMargin/MainLayout/MasteryPanel"]
